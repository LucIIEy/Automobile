<?xml version="1.0" encoding="utf-8"?>
<resources>

    <color name="hyundai_navy">#002C5F</color>
    <color name="screen_background">#F2F4F7</color>
    <color name="surface_white">#FFFFFF</color>
    <color name="text_ink">#101114</color>
    <color name="text_muted">#626977</color>
    <color name="soft_gray">#F0F2F5</color>
    <color name="fuel_yellow">#FBC637</color>
    <color name="ready_green">#098653</color>

    <dimen name="screen_padding">32dp</dimen>
    <dimen name="panel_gap">32dp</dimen>
    <dimen name="header_height">48dp</dimen>
    <dimen name="section_height">44dp</dimen>
    <dimen name="card_padding">28dp</dimen>
    <dimen name="card_radius">28dp</dimen>

    <dimen name="text_small">14sp</dimen>
    <dimen name="text_body">16sp</dimen>
    <dimen name="text_section">22sp</dimen>
    <dimen name="text_title">52sp</dimen>
    <dimen name="text_title_min">32sp</dimen>
    <dimen name="title_height">144dp</dimen>
    <dimen name="text_choice">24sp</dimen>
    <dimen name="text_button">20sp</dimen>

    <dimen name="choice_height">112dp</dimen>
    <dimen name="icon_box">56dp</dimen>
    <dimen name="icon_size">28dp</dimen>
    <dimen name="button_height">64dp</dimen>
    <dimen name="logo_width">112dp</dimen>
    <dimen name="logo_height">80dp</dimen>
    <dimen name="step_width">28dp</dimen>
    <dimen name="step_height">10dp</dimen>

    <style name="TextBase">
        <item name="android:fontFamily">@font/pretendard_light</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_ink</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>

    <style name="TextStrong" parent="TextBase">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SurfaceCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_white</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardUseCompatPadding">false</item>
    </style>

    <style name="ActionButton" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/pretendard_light</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/surface_white</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/hyundai_navy</item>
        <item name="cornerRadius">100dp</item>
        <item name="iconTint">@color/surface_white</item>
    </style>

</resources>